  <!-- Hperlinking Policies -->
  <div class="modal fade" id="fmyModal4" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
    
      <!-- Modal content-->
      <div class="modal-content">
        <div class="modal-header">
          
          <h4 class="modal-title">ಹೈಪರ್ಲಿಂಕಿಂಗ್ ನೀತಿ</h4>
          <button type="button" class="btn btn-danger pull-right cls-btn btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
        <div class="modal-body">
          
         <h6>(ಆಯಾ ಇಲಾಖೆಗೆ ತಮ್ಮ ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲಿ ಹೈಪರ್ಲಿಂಕ್ ಮಾಡಲು ಯಾವುದೇ ಅನುಮತಿ ಅಗತ್ಯವಿಲ್ಲದಿದ್ದರೆ)</h6>

           <p>1)ನಮ್ಮ ಸೈಟ್‌ನಲ್ಲಿ ಹೋಸ್ಟ್ ಮಾಡಲಾದ ಮಾಹಿತಿಯೊಂದಿಗೆ ನೇರವಾಗಿ ಲಿಂಕ್ ಮಾಡುವುದನ್ನು ನಾವು ಆಕ್ಷೇಪಿಸುವುದಿಲ್ಲ ಮತ್ತು ಅದಕ್ಕಾಗಿ ಯಾವುದೇ ಪೂರ್ವ ಅನುಮತಿ ಅಗತ್ಯವಿಲ್ಲ.</p>

           <p>2)ನಮ್ಮ ಪುಟಗಳನ್ನು ಇತರ ಸೈಟ್‌ಗಳಲ್ಲಿ ಫ್ರೇಮ್‌ಗಳಲ್ಲಿ ಲೋಡ್ ಮಾಡಲು ನಾವು ಅನುಮತಿಸುವುದಿಲ್ಲ. ನಮ್ಮ ಇಲಾಖೆಯ ಪುಟಗಳು ಬಳಕೆದಾರರ ಹೊಸದಾಗಿ ತೆರೆದ ಬ್ರೌಸರ್ ವಿಂಡೋಗೆ ಲೋಡ್ ಆಗಬೇಕು.</p>

        <h6>(ವೆಬ್‌ಸೈಟ್‌ಗೆ ಹೈಪರ್ಲಿಂಕ್ ಅನುಮತಿ ಅಗತ್ಯವಿದ್ದರೆ)</h6>
        
           <p>1)ಈ ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲಿ ಯಾವುದೇ ಲಿಂಕ್ ಅಥವಾ ಅದರ ಫಾರ್ಮ್ ಅನ್ನು ಒದಗಿಸಲು, ಅನುಮತಿಯನ್ನು ಪಡೆಯುವುದು ಕಡ್ಡಾಯವಾಗಿದೆ.</p>  

           <p>2)ಈ ಇಮೇಲ್‌ಗೆ ವಿನಂತಿಸುವ ಮೂಲಕ ಇ-ಆಡಳಿತಕ್ಕಾಗಿ ಕೇಂದ್ರದಿಂದ ಅನುಮತಿಯನ್ನು ಪಡೆಯಬಹುದು. spm.webportal@karnataka.gov.in</p>
 
           <p>3)ಈ ಸರ್ಕಾರಿ ವೆಬ್‌ಸೈಟ್ ಟಿಪ್ಪಣಿಯನ್ನು ಬಿಡುವ ಮೊದಲು: ಈ ಸಂಪರ್ಕ ಬಟನ್ ಮತ್ತೊಂದು ವೆಬ್‌ಸೈಟ್‌ಗೆ ಕಾರಣವಾಗುತ್ತದೆ, ಅಂತಹ ಹೊಸ ತೆರೆದ ಸೈಟ್‌ನ ಕುರಿತು ಹೆಚ್ಚಿನ ಮಾಹಿತಿ ಪಡೆಯಲು, ಆ ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲಿ ನೋಂದಾಯಿಸಲಾದ ಸಂಬಂಧಪಟ್ಟ ಸಂಪರ್ಕಗಳನ್ನು ಸಂಪರ್ಕಿಸಬೇಕು.</p>
         

        </div>
      
      </div>
      
    </div>
  </div>
   



