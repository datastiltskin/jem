<script>
      
   $('[data-fancybox="gallery"]').fancybox({
  buttons: [
    "slideShow",
    "thumbs",
    "zoom",
    "fullScreen",
    "share",
    "close"
  ],
  loop: false,
  protect: true
});
</script> 
<script>
document.addEventListener("DOMContentLoaded", function() {
    const toggle = document.getElementById('toggle');
    const darkModeAreas = document.querySelectorAll('.dark-mode-area');

    // Define the dark mode CSS for specific classes and elements
    const darkModeCSS = `
        .dark-mode-area.dark-mode h1,
        .dark-mode-area.dark-mode header,
        .dark-mode-area.dark-mode body,
        .dark-mode-area.dark-mode div,
        .dark-mode-area.dark-mode span,
        .dark-mode-area.dark-mode h6,
        .dark-mode-area.dark-mode li,
        .dark-mode-area.dark-mode p,
        .dark-mode-area.dark-mode .header,
        .dark-mode-area.dark-mode .navbar-sec,
        .dark-mode-area.dark-mode button,
        .dark-mode-area.dark-mode section,
        .dark-mode-area.dark-mode extramenudesk,
        .dark-mode-area.dark-mode dropdown-menu,
        .dark-mode-area.dark-mode dropdown,
        .dark-mode-area.dark-mode nav-item,
        .dark-mode-area.dark-mode nav-link,
        .dark-mode-area.dark-mode .dropdown-menu.show,
        .dark-mode-area.dark-mode .dropdown-menu a,
        .dark-mode-area.dark-mode .closebtn,
        .dark-mode-area.dark-mode .btn,
        .dark-mode-area.dark-mode td,
         .dark-mode-area.dark-mode th,
         .dark-mode-area.dark-mode table,
            .dark-mode-area.dark-mode .extramenudesk li a,
         .dark-mode-area.dark-mode thead,
        .dark-mode-area.dark-mode .subHeaderFontSize,
            .dark-mode-area.dark-mode .nav-item.dropdown:hover > .dropdown-menu,
        body.dark-mode-area.dark-mode {
            background-color: #121212 !important;
            color: #ffffff  !important;
            background-image: none !important;
        }
        .dark-mode-area.dark-mode button {
            border-color: #ffffff  !important;
            background-color: #333333  !important;
        }
        .dark-mode-area.dark-mode .background {
            background-color: #333333  !important;
        }
        .dark-mode-area.dark-mode .carousel-indicators {
            display: none !important;
        }
    `;

    // Create a style element
    const styleElement = document.createElement('style');
    styleElement.type = 'text/css';
    styleElement.appendChild(document.createTextNode(darkModeCSS));
    document.head.appendChild(styleElement);

    // Load saved mode from localStorage
    if (localStorage.getItem('darkMode') === 'enabled') {
        darkModeAreas.forEach(area => area.classList.add('dark-mode'));
        toggle.checked = true;
    }

    toggle.addEventListener('change', function() {
        if (this.checked) {
            darkModeAreas.forEach(area => area.classList.add('dark-mode'));
            localStorage.setItem('darkMode', 'enabled');
        } else {
            darkModeAreas.forEach(area => area.classList.remove('dark-mode'));
            localStorage.setItem('darkMode', 'disabled');
        }
    });
});
</script>

     <script>
        const minFontSize = 16;
        const maxFontSize = 19;
        const normalFontSize = 18; // Set this to your normal font size

        const decreaseButton = document.getElementById('fontDecrease');
        const increaseButton = document.getElementById('fontIncrease');
        const resetButton = document.getElementById('fontReset');
        const targetElements = document.querySelectorAll('p, h1, h2, a, li');

        let currentFontSize = parseInt(window.getComputedStyle(targetElements[0]).fontSize, 10);

        function updateFontSize(size) {
            if (size >= minFontSize && size <= maxFontSize) {
                targetElements.forEach(el => {
                    el.style.fontSize = `${size}px`;
                });
                currentFontSize = size;
            }
        }

        decreaseButton.addEventListener('click', () => {
            updateFontSize(currentFontSize - 1);
        });

        increaseButton.addEventListener('click', () => {
            updateFontSize(currentFontSize + 1);
        });

        resetButton.addEventListener('click', () => {
            // Reload the page to reset font sizes to default
            location.reload();
        });

$(document).ready(function() {


    // Optional: If you want to ensure .hamburger doesn't get the active class
    $('.hamburger').on('click', function(event) {
       $(this).removeClass('active');
    });
});

    </script>
	
	
</body>
</html>

