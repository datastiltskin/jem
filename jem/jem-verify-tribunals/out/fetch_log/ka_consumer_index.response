<form id="searchForm_en" method="GET" class="">
  <div class="search-box" id="searchBox">
    <input type="text" name="search" id="searchInput_en" class="search-txt" placeholder="Search...">
    <button type="submit" class="search-btn" id="searchBtn">
      <i class="fa fa-search"></i>
    </button>
  </div>
</form>





<script>
  const searchBox = document.getElementById('searchBox');
  const searchBtn = document.getElementById('searchBtn');
  const searchInput = document.getElementById('searchInput_en');
  const searchForm_en = document.getElementById('searchForm_en');

  searchBtn.addEventListener('click', function (e) {
    // If not active, activate it and focus
    if (!searchBox.classList.contains('active')) {
      e.preventDefault(); // Stop submit
      searchBox.classList.add('active');
      searchInput.focus();
    } else if (searchInput.value.trim() === '') {
      e.preventDefault(); // Don't submit if empty
      searchInput.focus();
    }
    // Else allow normal form submission
  });

  // Custom form submission logic
  searchForm_en.addEventListener('submit', function (e) {
    e.preventDefault();
    const value = searchInput.value.trim();
    if (value !== '') {
		var url = 'https://kscdrc.karnataka.gov.in/search/' + encodeURIComponent(value)+"/en";
	//	alert(url);
     window.location.href = url;
    }
  });

  // Close search box on click outside
  document.addEventListener('click', function (e) {
    if (!searchBox.contains(e.target)) {
      searchBox.classList.remove('active');
    }
  });
</script>





             


