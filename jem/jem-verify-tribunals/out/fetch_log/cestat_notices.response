    $.fn.exists = function() {
      return this.length > 0;
  };
    
    if ($('#captcha').exists()) { // Replace 'myElement' with your ID
      $('#captcha_code').val('111111'); 
      $('#captcha,.refresh,#captcha_code').hide(); 
  } 
  
} );

</script>
</body>
</html>
