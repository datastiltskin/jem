			&lt;/td>
			&lt;td style=&quot;width:138.3pt&quot;>
			&lt;p style=&quot;text-align:justify&quot;>&lt;span style=&quot;font-family:Times New Roman,Times,serif&quot;>&lt;span style=&quot;font-size:16px&quot;>&lt;span style=&quot;color:black&quot;>190&lt;/span>&lt;/span>&lt;/span>&lt;/p>
			&lt;/td>
		&lt;/tr>
		&lt;tr>
