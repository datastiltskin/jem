<style>
/* Hide the buttons by default */
.carousel-control-prev,
.carousel-control-next {
    opacity: 0;
    transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
}
#playPauseButton{position: absolute;
    right: 8px;
    bottom: 4px;
    background: #00000087;
    color: #fff;
    line-height: 0;
    width: 35px;
    height: 35px;}
/* Show buttons on hover */
.slider:hover .carousel-control-prev,
.slider:hover .carousel-control-next {
    opacity: 1;
}

/* Animate buttons from the sides on hover */
.slider:hover .carousel-control-prev {
    transform: translate(-20px, -50%);
}
.carousel-item {
    transition: transform 0.6s ease-in-out !important;
}

.slider:hover .carousel-control-next {
    transform: translate(20px, -50%);
}

/* Button styles */
.carousel-control-prev i,
.carousel-control-next i {
    font-size: 45px;position:absolute;
    color: #fff;
}
.carousel-control-prev i{left:50px;}
.carousel-control-next i{right:50px;}
.carousel-control-prev {
    left: 10px;
}

.carousel-control-next {
    right: 10px;
}

</style>
