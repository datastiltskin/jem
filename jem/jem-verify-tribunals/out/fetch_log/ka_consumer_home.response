<style>
@keyframes blink {
    0% { 
       color: #000000;
       background-color: #dadada;
    }
    40% { 
         color: #000000;
         background-color: #dadada;
    }
    50% { 
        color: white; 
        background-color: red; 
    }
    60% { 
        color: white; 
        background-color: red; 
    }
    100% { 
         color: #000000;
         background-color: #dadada;
    }
}

.blinking {
    animation: blink 1s infinite; /* Adjusted to 1s for a smooth transition */
}

#view_news:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--primary-color);
    filter: brightness(0.7);
    z-index: -1;
}
