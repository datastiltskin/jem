<script>
var carouselElement = document.getElementById('demo');
var carousel = new bootstrap.Carousel(carouselElement, {
    interval: 7500, // Carousel interval

    ride: 'carousel'    // Do not pause on hover
});
console.log(new bootstrap.Carousel(document.getElementById('demo')));
var playPauseButton = document.getElementById('playPauseButton');
var isPlaying = true; // Start with autoplay enabled

playPauseButton.addEventListener('click', function() {
    if (isPlaying) {
        carousel.pause(); // Pause the carousel
        playPauseButton.innerHTML = '<i class="fa fa-play"></i>'; // Change icon to play
    } else {
        carousel.cycle(); // Resume the carousel
        playPauseButton.innerHTML = '<i class="fa fa-pause"></i>'; // Change icon to pause
    }
    isPlaying = !isPlaying; // Toggle the state
});

</script>





<style type="text/css">

.news-container {
width: 100%;
    overflow: hidden;
    border: 1px solid #000;
    position: relative;
    padding: 0px;
    margin: 0;
}
.news_count_front span {
    width: 27px;
    height: 20px;
    display: block;
    padding-top: 2px;

    z-index: 9999;
}
.news_label,.news_label:hover{    position: absolute;
    left: 0;
    z-index: 1;background: #f33636 ;}

.news-wrapper {
    display: flex;
    transition: transform 0.5s ease;
    width: 100%; /* Adjust to contain all news items */
}
.news-item a{display: flex;}
.news-item {
min-width: 100%;
    padding: 2px;
    background: #ffffff;
    border-right: 2px solid #ddd;
    text-align: center;
    color: black;
    font-size: 16px;
    font-weight: 600;
}

.controls {
    position: absolute;
    top: 50%;
    right: 0px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: row;
}

.news button {
    padding: 8px 15px;
    margin-left: 0px;
    border: none;
    background-color: #464646;
    color: white;
    cursor: pointer;    padding-top: 14px;z-index:1;
}
#pause{width: 42px;}

.news button:hover {
    background-color: #515253;
}
</style>
<style>
            .news_count_front{padding: 6px 4px !important;}
            .news-item a{margin-left:11% ;}
          </style>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12 news-container news">
            <button id="view_news_btn" class="pull-left news_label" data-bs-toggle="modal" data-bs-target="#newsModal">
                <i class="fa fa-newspaper-o"></i>                 ಸುದ್ದಿ ಮತ್ತು ಘಟನೆಗಳು                 
            </button>
            <div class="news-wrapper">
                                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/11-06-2025.jpeg">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 1</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    One year ago                                </span>
                            </div>
                                <span class="pcontent"> KSCDRC Channel- Please scan the QR code and join the chennel.  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/notification7-2-2025001.pdf">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 2</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    2 years ago                                </span>
                            </div>
                                <span class="pcontent"> ಅಧಿಸೂಚನೆ - ಬೆಳಗಾವಿಯಲ್ಲಿನ ರಾಜ್ಯ ಆಯೋಗದ ಖಾಯಂ ಸಂಚಾರಿ ಪೀಠದ ರಚನೆ - ವಿಡಿಯೋ ಸಂವಾದದ ಮೂಲಕ ಕಲಾಪ ಜರುಗಿಸುವ ಬಗ್ಗೆ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/notification4-02-2025001.pdf">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 3</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    2 years ago                                </span>
                            </div>
                                <span class="pcontent"> ಅಧಿಸೂಚನೆ - 
ಬೆಳಗಾವಿಯಲ್ಲಿ ರಾಜ್ಯ ಆಯೋಗದ ಖಾಯಂ ಸಂಚಾರಿ ಪೀಠದ ಉದ್ಘಾಟನೆ ಮತ್ತು ಕಾರ್ಯಾರಂಭದ ಬಗ್ಗೆ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/KalburgiBench.PDF">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 4</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    2 years ago                                </span>
                            </div>
                                <span class="pcontent"> ಅಧಿಸೂಚನೆ - ಕಲಬುರಗಿಯಲ್ಲಿನ ರಾಜ್ಯ ಆಯೋಗದ ಖಾಯಂ ಸಂಚಾರಿ ಪೀಠದ ರಚನೆ - ವಿಡಿಯೋ ಸಂವಾದದ  ಮೂಲಕ ಕಲಾಪ ಜರುಗಿಸುವ ಬಗ್ಗೆ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/AppealfilesenttoKalburgi.pdf">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 5</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    2 years ago                                </span>
                            </div>
                                <span class="pcontent"> ರಾಜ್ಯ ಆಯೋಗದ ಕಲಬುರ್ಗಿ ಪೀಠದಲ್ಲಿ ಪ್ರಕರಣಗಳನ್ನು ಕ್ಯೆಗೆತ್ತಿಕೊಂಡು ನಡೆಸುವ ಸಲುವಾಗಿ ರಾಜ್ಯ ಆಯೋಗ, ಬೆಂಗಳೂರು, ಇಲ್ಲಿಂದ ಕಲಬುರ್ಗಿ ಪೀಠಕ್ಕೆ ವರ್ಗಾಯಿಸಿರುವ ಮೇಲ್ಮನವಿ ಪ್ರಕಾರಣಗಳ ಪಟ್ಟಿ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/Notification/NotificationInaugurationandcommencementofStateCommission'spermanentCircuitBenchatKalburgi.pdf">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 6</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    2 years ago                                </span>
                            </div>
                                <span class="pcontent"> ಅಧಿಸೂಚನೆ - ಕಲ್ಬುರ್ಗಿಯಲ್ಲಿ ರಾಜ್ಯ ಆಯೋಗದ ಖಾಯಂ ಸಂಚಾರಿ ಪೀಠದ ಉದ್ಘಾಟನೆ ಮತ್ತು ಕಾರ್ಯಾರಂಭದ ಬಗ್ಗೆ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/Notification/Notification 13122023.pdf">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 7</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    3 years ago                                </span>
                            </div>
                                <span class="pcontent"> ಮೇಲ್ಮನವಿ ಶಾಸನಬದ್ಧ ಠೇವಣಿಗಾಗಿ ಅಧಿಸೂಚನೆ-ಪಾವತಿ ಅಧಿಸೂಚನೆ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://www.onlinesbi.sbi/sbicollect/icollecthome.htm?corpID=5958414">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 8</span></span> 
                                  <!-- Display New label -->
                               
                                <span class="news_count">
                                    3 years ago                                </span>
                            </div>
                                <span class="pcontent"> ಮೇಲ್ಮನವಿಯಲ್ಲಿ ಶಾಸನಬದ್ಧ ಠೇವಣಿ ಇಡಲು(10 ಲಕ್ಷದವರೆಗೆ ಮಾತ್ರ) ಈ ಎಸ್ ಬಿ ಐ ಲಿಂಕ್ ಅನ್ನು ಉಪಯೋಗಿಸಿ  </span>
                            </a>
                        </div>
                                            <div class="news-item col-md-12">
                            <a href="https://kscdrc.karnataka.gov.in/storage/pdf-files/OnlineFiling.jpg">
                                <div class="dflex lncombo">
                                <span class="news_count_front "><span> 9</span></span> 
