</style>


<script>
 $(document).ready(function() {
    const newsWrapper = $('.news-wrapper');
    const newsItems = $('.news-item');
    const newsCount = newsItems.length;
    let currentIndex = 0;
    let interval;
    let isPaused = false;

    // Function to move to a specific index
    function goToNews(index) {
        const offset = -index * 100; // 100% width of each news item
        newsWrapper.css('transform', `translateX(${offset}%)`);
        currentIndex = index;
    }

    // Move to the next news
    function nextNews() {
        if (currentIndex < newsCount - 1) {
            goToNews(currentIndex + 1);
        } else {
            goToNews(0); // Loop back to the first news item
        }
    }

    // Move to the previous news
    function prevNews() {
        if (currentIndex > 0) {
            goToNews(currentIndex - 1);
        } else {
            goToNews(newsCount - 1); // Loop back to the last news item
        }
    }

    // Auto-scroll function
    function startAutoScroll() {
        interval = setInterval(function() {
            nextNews();
        }, 5000); // Scroll every 5 seconds
    }

    // Stop auto-scroll
    function stopAutoScroll() {
        clearInterval(interval);
    }

    // Restart auto-scroll after manual action with full 5-second delay
    function resetAutoScroll() {
        stopAutoScroll();  // Stop the current interval
        startAutoScroll(); // Restart with a fresh interval
    }

    // Initial auto-scroll
    startAutoScroll();

    // Button controls
    $('#next').click(function() {
        stopAutoScroll();  // Stop to avoid conflicts
        nextNews();        // Manually move to the next news
        resetAutoScroll(); // Restart the auto-scroll timer
    });

    $('#prev').click(function() {
        stopAutoScroll();  // Stop to avoid conflicts
        prevNews();        // Manually move to the previous news
        resetAutoScroll(); // Restart the auto-scroll timer
    }); 

    // Pause and resume scrolling, and change the icon
    $('#pause').click(function() {
        if (isPaused) {
            startAutoScroll();
            $(this).html('<i class="fa fa-pause" aria-hidden="true"></i>'); // Change to pause icon
        } else {
            stopAutoScroll();
            $(this).html('<i class="fa fa-play" aria-hidden="true"></i>'); // Change to play icon
        }
        isPaused = !isPaused; // Toggle the pause state
    });

    // Pause auto-scroll on hover
    $('.news-container').mouseenter(function() {
        stopAutoScroll();
    });

    // Resume auto-scroll when mouse leaves the news container (only if not paused)
    $('.news-container').mouseleave(function() {
        if (!isPaused) {
            resetAutoScroll(); // Ensure the timer is reset when leaving
        }
    });
});

</script>




