<style>
.news-marquee-bar {
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 10px 15px;
    gap: 15px;
}
.news-marquee-playpause {
    flex-shrink: 0;
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
}
.news-marquee-playpause:hover {
    background: rgba(255,255,255,0.3);
}
.news-marquee-track {
    overflow: hidden;
    flex: 1;
    min-width: 0;
}
.news-marquee-content {
    display: inline-block;
    white-space: nowrap;
    padding-left: 100%;
    color: #fff;
    font-size: 15px;
    animation: newsMarqueeScroll 18s linear infinite;
}
.news-marquee-content a {
    color: #38bdf8;
    text-decoration: underline;
    font-weight: bold;
    cursor: pointer;
}
/* Hover pauses temporarily; the button's .is-paused class pauses persistently */
.news-marquee-bar:hover .news-marquee-content,
.news-marquee-content.is-paused {
    animation-play-state: paused;
}
@keyframes newsMarqueeScroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
}
</style>

<!--
    No placeholder div needed. The script below finds YOUR existing
    carousel (id="demo") wherever it sits in the page, and appends the
    marquee bar immediately after it — on every page/site that includes
    this file.
-->
<script>
(function() {
    'use strict';

    const afterSelector = '#demo';   // your existing image carousel's id
    const marqueeText   = "ರಾಜ್ಯದಾದ್ಯಂತ ಪ್ರಜಾಸೇವೆ ಅಭಿಯಾನ ಸಭೆಗಳನ್ನು ಆಯೋಜಿಸುವ ಕುರಿತು ಮಾರ್ಗಸೂಚಿಗಳನ್ನು ಹೊರಡಿಸಲಾಗಿದೆ. ವೀಕ್ಷಿಸಲು ಇಲ್ಲಿ ಕ್ಲಿಕ್‌ ಮಾಡಿ";
    const pdfLink       = "https:\/\/webportal.karnataka.gov.in\/uploads\/circular_prajaseva_28_08_26.pdf";
    const bgColor       = "#1e293b";
    const clickPhrase   = 'ಇಲ್ಲಿ ಕ್ಲಿಕ್\u200c ಮಾಡಿ';

    function buildMarqueeHTML() {
        const linkedText = marqueeText.replace(
            clickPhrase,
            `<a href="${pdfLink}" target="_blank">${clickPhrase}</a>`
        );
        return `
            <div class="news-marquee-bar" style="background:${bgColor};">
                <div class="news-marquee-track">
                    <div class="news-marquee-content" id="newsMarqueeContent">
                        ↗️ ${linkedText}
                    </div>
                </div>
                <button class="news-marquee-playpause" id="newsMarqueePlayPause" aria-label="Pause marquee">
                    <i class="fas fa-pause"></i>
                </button>
            </div>
        `;
    }

    function initPlayPause() {
        const btn = document.getElementById('newsMarqueePlayPause');
        const content = document.getElementById('newsMarqueeContent');
        if (!btn || !content) return;

        btn.addEventListener('click', function() {
            const nowPaused = content.classList.toggle('is-paused');
            this.querySelector('i').className = nowPaused ? 'fas fa-play' : 'fas fa-pause';
            this.setAttribute('aria-label', nowPaused ? 'Play marquee' : 'Pause marquee');
        });
    }

    function appendMarquee() {
        const targetEl = document.querySelector(afterSelector);
        if (!targetEl) {
            console.warn(`Target element "${afterSelector}" not found. Marquee not added.`);
            return;
        }
        targetEl.insertAdjacentHTML('afterend', buildMarqueeHTML());
        initPlayPause();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', appendMarquee);
    } else {
        appendMarquee();
    }
})();
</script>
  <style>

    .sbox { transition: 0.2s; border-radius: 1.2rem; padding: 0.6rem 0.3rem; background: white; box-shadow: 0 4px 10px rgba(0,0,0,0.02); border: 1px solid #f0f2f5;text-align:center;width:auto; }
.card-grid{    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;}
    .sbox img { height: 62px; object-fit: contain; margin-bottom: 6px; }
    .sbox p { font-size: 0.8rem; font-weight: 500; margin: 0; color: #1e2a3a; line-height: 1.3; }
    .modal-header { border-bottom: 2px solid #0d6efd; background: #fafcff; border-radius: 24px 24px 0 0; }
    .modal-title { font-weight: 700; color: #0d6efd; }
    .modal-body .row { row-gap: 1.2rem; }
    .owl-links .item1 { 
      background: white; 
      border-radius: 24px; 
      padding: 14px 6px; 
      text-align: center; 
      box-shadow: 0 6px 16px rgba(0,0,0,0.04); 
      transition: all 0.2s; 
      cursor: pointer;
      margin: 10px 6px;
      font-weight: 500;
      color: #1e293b;
      border: 1px solid rgba(0,0,0,0.02);
      font-size: 0.85rem;display: block;
    }
    .owl-links .item1:hover { background: #e9f0ff; border-color: #0d6efd40; box-shadow: 0 8px 20px rgba(13,110,253,0.08); }
    .owl-links .item1 img { height: 52px; object-fit: contain; display: block; margin: 0 auto 8px; }
    #container_owl { padding: 1rem 0.5rem; }
    .modal-content { border-radius: 28px; border: none; box-shadow: 0 24px 60px rgba(0,0,0,0.08); overflow: hidden; }
    .modal-footer { border-top: none; padding-top: 0; }
    .card-grid .col-md-3 { display: flex; align-items: stretch; }
    .sbox a { text-decoration: none; display: block; width: 100%; height: 100%; padding: 0.3rem 0.1rem; }
    .sbox a p { color: #0b2b4a; }
    .modal-dialog { max-width: 880px; }
    @media (max-width: 576px) { .sbox img { height: 44px; } .owl-links .item1 img { height: 38px; } }
    .lazy-load { transition: opacity 0.2s; }
    .modal-header .btn-close { filter: none; }
    .sbox#modal_icons { background: #ffffff; }
    .sbox#modal_icons:nth-child(odd) { background: #f8faff; }
  </style>


