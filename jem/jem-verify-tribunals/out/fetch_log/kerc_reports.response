  <style type="text/css">
     #slideshow 
    {
      position: relative;
      width: 100%;
      height: 300px;
      padding: 0px;
      box-shadow: 0 0 0px rgba(0, 0, 0, 0.4);
      border: 0px solid red;
    }

    #slideshow > div 
    {
      position: absolute;
      top: 0px;
      left: 0px;
      right: 10px;
      bottom: 10px;
      width: 100%;
      border: 0px solid blue;
      height: 300px;
    }

    .slider_image
    {
      width: 100%;
      height: 300px;
      border: 0px solid green;
    }

    .sticky 
    {
        position: fixed;
        top: 0;
        width: 100%;
    }
 


  </style>

