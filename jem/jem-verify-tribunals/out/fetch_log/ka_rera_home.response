<style>
.prev, .next {
	padding: 5px 10px;
	margin: 5px 10px;
	background-color: #3948B1;
	float: right;
	color: #AECBD9;
	border-radius: 10px;
}

.prev, .next : hover {
	color: white;
}

#popup {
    position: fixed;
    margin:0 auto;
    top: 53%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.cnt223 {
    min-width: 400px;
    width: 800px;
    min-height: 150px;
    margin: -30vh 30vh;
