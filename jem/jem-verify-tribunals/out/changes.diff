+def main():
+    (ROOT / "inputs/verifier_prompt.md").chmod(0o444)
+    assert digest(ROOT / "inputs/verifier_prompt.md") == PROMPT_SHA
+    assert digest(ROOT / "inputs/claims_to_verify.csv") == CLAIMS_SHA
